@page
@model Web9000.Pages.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 - @Model.CompanyName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            max-width: 450px;
            width: 100%;
            padding: 40px;
        }
        .company-logo {
            max-width: 150px;
            max-height: 80px;
            margin-bottom: 20px;
        }
        .btn-login {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
@*             <img src="@Model.CompanyLogo" alt="@Model.CompanyName" class="company-logo" onerror="this.style.display='none'"> *@
            <h3 class="fw-bold">@Model.CompanyName</h3>
            <p class="text-muted">差勤查詢系統</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form method="post" id="loginForm">
            <div class="mb-3">
                <label for="LoginName" class="form-label fw-semibold">登入帳號</label>
                <input type="text" 
                       class="form-control form-control-lg" 
                       id="LoginName" 
                       name="LoginName" 
                       asp-for="LoginName" 
                       placeholder="請輸入帳號" 
                       required 
                       autofocus>
            </div>

            <div class="mb-4">
                <label for="LoginPassword" class="form-label fw-semibold">登入密碼</label>
                <input type="password" 
                       class="form-control form-control-lg" 
                       id="LoginPassword" 
                       name="LoginPassword" 
                       asp-for="LoginPassword" 
                       placeholder="請輸入密碼" 
                       required>
            </div>

            <button type="submit" class="btn btn-primary btn-login">
                登入
            </button>
        </form>

        <div class="text-center mt-4">
            <img src="@Model.CompanyLogo" alt="@Model.CompanyName" class="company-logo" onerror="this.style.display='none'">
            <small class="text-muted">© 2016~@DateTime.Now.Year 甘丹科技 All rights reserved.</small>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // 按下 Enter 後送出表單
        document.getElementById('LoginPassword').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('loginForm').submit();
            }
        });

        // 表單送出前檢查
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            const loginName = document.getElementById('LoginName').value.trim();
            const loginPassword = document.getElementById('LoginPassword').value.trim();

            if (!loginName || !loginPassword) {
                e.preventDefault();
                alert('請輸入帳號與密碼');
                return false;
            }
        });
    </script>
</body>
</html>
