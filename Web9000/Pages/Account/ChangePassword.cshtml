@page
@model Web9000.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "修改密碼";
}

<div class="container-fluid">
    <h2 class="mb-4">
        <i class="bi bi-key"></i> 修改密碼
    </h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-shield-lock"></i> 密碼變更
                </div>
                <div class="card-body">
                    <form method="post" id="changePasswordForm">
                        <div class="mb-3">
                            <label for="oldPassword" class="form-label">原始密碼 <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input type="password" 
                                       class="form-control" 
                                       id="oldPassword" 
                                       asp-for="OldPassword" 
                                       placeholder="請輸入原始密碼" 
                                       required />
                                <button class="btn btn-outline-secondary" 
                                        type="button" 
                                        onclick="togglePassword('oldPassword')">
                                    <i class="bi bi-eye" id="oldPassword-icon"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">新密碼 <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input type="password" 
                                       class="form-control" 
                                       id="newPassword" 
                                       asp-for="NewPassword" 
                                       placeholder="請輸入新密碼" 
                                       required />
                                <button class="btn btn-outline-secondary" 
                                        type="button" 
                                        onclick="togglePassword('newPassword')">
                                    <i class="bi bi-eye" id="newPassword-icon"></i>
                                </button>
                            </div>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> 建議使用 8 位以上包含英數字的組合
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">確認密碼 <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input type="password" 
                                       class="form-control" 
                                       id="confirmPassword" 
                                       asp-for="ConfirmPassword" 
                                       placeholder="請再次輸入新密碼" 
                                       required />
                                <button class="btn btn-outline-secondary" 
                                        type="button" 
                                        onclick="togglePassword('confirmPassword')">
                                    <i class="bi bi-eye" id="confirmPassword-icon"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> 儲存
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="resetForm()">
                                <i class="bi bi-x-circle"></i> 清除
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body bg-light">
                    <h6 class="card-title"><i class="bi bi-lightbulb"></i> 安全提示</h6>
                    <ul class="mb-0 small">
                        <li>請定期更換密碼以確保帳號安全</li>
                        <li>不要使用過於簡單或容易猜測的密碼</li>
                        <li>不要與他人分享您的密碼</li>
                        <li>如發現帳號異常，請立即修改密碼並聯絡系統管理員</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(inputId + '-icon');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        function resetForm() {
            document.getElementById('changePasswordForm').reset();
        }

        // 表單驗證
        document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (newPassword !== confirmPassword) {
                e.preventDefault();
                alert('新密碼與確認密碼不一致');
                return false;
            }
        });
    </script>
}
