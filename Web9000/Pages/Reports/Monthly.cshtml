@page
@model Web9000.Pages.Reports.MonthlyModel
@{
    ViewData["Title"] = "月報表";
}

<div class="container-fluid">
    <h2 class="mb-4">
        <i class="bi bi-calendar3"></i> 月報表
    </h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-funnel"></i> 查詢條件
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Export" id="exportForm">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label for="reportYear" class="form-label">年度</label>
                        <select class="form-select" id="reportYear" asp-for="ReportYear" asp-items="Model.YearList" required>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="reportMonth" class="form-label">月份</label>
                        <select class="form-select" id="reportMonth" asp-for="ReportMonth" asp-items="Model.MonthList" required>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="department" class="form-label">部門</label>
                        <select class="form-select" id="department" asp-for="SelectedDepartmentId" asp-items="Model.DepartmentList" onchange="onDepartmentChange()">
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="employee" class="form-label">員工</label>
                        <select class="form-select" id="employee" asp-for="SelectedEmployeeNo" asp-items="Model.EmployeeList">
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-file-earmark-excel"></i> 匯出
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4">
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-info-circle fs-1 text-muted"></i>
                <p class="text-muted mt-3 mb-0">請選擇年月與條件後按下「匯出」按鈕產生月報表</p>
                <p class="text-muted small">註：每個員工將產生一個獨立的工作表</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const queryEmployeesUrl = '@Url.Page("/Records/Query", "Employees")';

        async function onDepartmentChange() {
            const deptId = document.getElementById('department').value;
            if (!deptId) {
                document.getElementById('employee').innerHTML = '<option value="">請先選擇部門</option>';
                return;
            }

            try {
                const response = await fetch(`${queryEmployeesUrl}&departmentId=${deptId}`);
                if (!response.ok) throw new Error('網路錯誤');

                const employees = await response.json();
                const employeeSelect = document.getElementById('employee');

                employeeSelect.innerHTML = '';

                employees.forEach(emp => {
                    const option = document.createElement('option');
                    option.value = emp.value;
                    option.textContent = emp.text;
                    employeeSelect.appendChild(option);
                });
            } catch (error) {
                console.error('載入員工列表失敗:', error);
                alert('載入員工列表失敗，請稍後再試');
            }
        }

        // 表單送出時顯示載入提示
        document.getElementById('exportForm').addEventListener('submit', function() {
            const btn = this.querySelector('button[type="submit"]');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>匯出中...';

            // 檔案下載不會觸發頁面跳轉，所以2秒後恢復按鈕狀態
            setTimeout(function() {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }, 2000);
        });
    </script>
}
